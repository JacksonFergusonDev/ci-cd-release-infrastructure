{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        ":pinDigestsDisabled"
    ],
    "automerge": true,
    "automergeType": "pr",
    "platformAutomerge": true,
    "rebaseWhen": "auto",
    "pre-commit": {
        "enabled": true
    },
    "pep723": {
        "managerFilePatterns": [
            "/^scripts/release\\.py$/"
        ]
    },
    "packageRules": [
        {
            "description": "Homebrew/actions is updated by the custom manager instead.",
            "matchManagers": [
                "github-actions"
            ],
            "matchPackageNames": [
                "Homebrew/actions"
            ],
            "enabled": false
        },
        {
            "description": "Pin digests for GitHub Actions",
            "matchManagers": [
                "github-actions"
            ],
            "pinDigests": true
        },
        {
            "description": "Group all non-major GitHub Action updates (digests, pins, patch, minor)",
            "matchManagers": [
                "github-actions",
                "custom.regex"
            ],
            "matchUpdateTypes": [
                "digest",
                "pin",
                "patch",
                "minor",
                "pinDigest"
            ],
            "groupName": "github-actions"
        },
        {
            "description": "Group all non-major dev dependencies",
            "matchDepTypes": [
                "dev",
                "dependency-groups"
            ],
            "matchUpdateTypes": [
                "patch",
                "minor"
            ],
            "groupName": "dev dependencies"
        },
        {
            "description": "Do not automerge major updates",
            "matchUpdateTypes": [
                "major"
            ],
            "automerge": false
        },
        {
            "description": "gitfluff v0.9.0's homebrew-tap submodule points at a commit that no longer exists, so the hook can't install. Skip it until a fixed release.",
            "matchPackageNames": [
                "Goldziher/gitfluff"
            ],
            "allowedVersions": "!/^v0\\.9\\.0$/"
        }
    ],
    "customManagers": [
        {
            "description": "Homebrew/actions tags have four parts (2026.09.28.1), and the github-actions manager reads at most three from a version comment, so it looks up a tag that doesn't exist.",
            "customType": "regex",
            "managerFilePatterns": [
                "/^\\.github/workflows/[^/]+\\.ya?ml$/"
            ],
            "matchStrings": [
                "uses:\\s*Homebrew/actions/[\\w-]+@(?<currentDigest>[a-f0-9]{40})\\s*#\\s*(?<currentValue>\\d+\\.\\d+\\.\\d+\\.\\d+)"
            ],
            "depNameTemplate": "Homebrew/actions",
            "datasourceTemplate": "github-tags",
            "versioningTemplate": "loose"
        }
    ]
}
